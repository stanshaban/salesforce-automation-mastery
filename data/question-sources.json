{
  "schemaVersion": 1,
  "checkedAt": "2026-11-09",
  "language": "ru",
  "purpose": "Авторские вопросы для самопроверки. Темы обобщены из учебного интервью; персональные данные и стенограмма в банк не включены.",
  "counts": {
    "base": 90,
    "variants": 30,
    "byLevel": {
      "junior": 30,
      "middle": 30,
      "senior": 30
    },
    "variantsByLevel": {
      "junior": 10,
      "middle": 11,
      "senior": 9
    }
  },
  "reviewPolicy": "Перепроверять версии и доступность функций при каждом сезонном релизе. Источники обосновывают технические факты; сценарии и варианты ответов написаны для SAM.",
  "versionCaveats": [
    {
      "topic": "Apex API 67.0",
      "note": "С API 67.0 database operations по умолчанию user mode; ≤66.0 — system mode. Для класса без sharing keyword API67 default with sharing; до67 отсутствие keyword сохраняет текущий sharing context, а не универсально without sharing. WITH SECURITY_ENFORCED не поддерживается с67.0.",
      "sourceUrl": "https://developer.salesforce.com/docs/platform/apex-ref/references/apex-ref/versioned-behavior-changes.html"
    },
    {
      "topic": "Explicit access mode",
      "note": "WITH USER_MODE применяет sharing, CRUD/FLS, даже если класс without sharing. В system mode record sharing зависит от class keyword; system mode не следует автоматически приравнивать к without sharing.",
      "sourceUrl": "https://developer.salesforce.com/docs/platform/apex-dev/references/apex-dev/apex-classes-enforce-usermode.html"
    },
    {
      "topic": "Manual shares и API68",
      "note": "Сохранение Manual shares при transfer зависит от Keep Manual Shares when Transferring Records. Sharing reasons для поддерживаемых standard objects доступны с Metadata API68.0; на detail master-detail без share object это не распространяется.",
      "sourceUrl": "https://developer.salesforce.com/docs/platform/api-metadata/references/meta-types/metadata-sharingreason.html",
      "additionalSourceUrl": "https://developer.salesforce.com/blogs/2026/10/protect-apex-shares-custom-row-causes-on-standard-objects"
    },
    {
      "topic": "Restriction rules",
      "note": "Работают только для поддерживаемых объектов/контекстов. Сужают существующий доступ, не дают новый. Критерии надо проектировать так, чтобы пользователю соответствовала одна активная rule; две rules не означают гарантированный AND.",
      "sourceUrl": "https://help.salesforce.com/s/articleView?id=platform.security_restriction_rule.htm&language=en_US&type=5"
    },
    {
      "topic": "Deferred sharing rules",
      "note": "Требует доступности функции в org. После Resume обязателен полный Recalculate накопленных изменений. Пауза не останавливает все механизмы sharing, включая manual shares.",
      "sourceUrl": "https://help.salesforce.com/s/articleView?id=platform.security_sharing_rule_recalculation.htm&language=en_US&type=5"
    },
    {
      "topic": "Platform Events",
      "note": "Стандартная retention PE/CDC —72часа; Replay ID непрозрачен и не служит универсальным уникальным ключом. Publish After Commit зависит от commit; Immediately может опередить commit или пережить rollback. Успешный SaveResult публикации не подтверждает обработку подписчиком.",
      "sourceUrl": "https://developer.salesforce.com/docs/platform/pub-sub-api/guide/event-message-durability.html",
      "additionalSourceUrl": "https://developer.salesforce.com/docs/platform/platform-events/guide/platform-events-publish-callbacks.html"
    },
    {
      "topic": "LWC",
      "note": "Не полагаться на фиксированный TTL Apex cache. refreshApex получает wire emission, notifyRecordUpdateAvailable обновляет знания LDS о записанных через Apex records. @track не наблюдает внутренние изменения Date/Set/Map.",
      "sourceUrl": "https://developer.salesforce.com/docs/platform/lwc/guide/apex-result-caching.html",
      "additionalSourceUrl": "https://developer.salesforce.com/docs/platform/lwc/guide/reactivity-fields.html"
    },
    {
      "topic": "Omni-Channel",
      "note": "Standard Omni-Channel retired в Summer’26; актуальные практики сверять с Enhanced Omni-Channel.",
      "sourceUrl": "https://help.salesforce.com/s/articleView?id=sf.omnichannel_std_vs_enhanced.htm&language=en_US&type=5"
    },
    {
      "topic": "Agentforce",
      "note": "На дату проверки agent testing в документации доступно в sandboxes, тесты могут менять данные. Data360-запросы во время тестов могут потреблять credits.",
      "sourceUrl": "https://developer.salesforce.com/docs/ai/agentforce/guide/testing-api-get-started.html"
    }
  ],
